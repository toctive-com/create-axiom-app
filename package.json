{
  "name": "create-axiom-app",
  "version": "0.1.8",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "create-axiom-app": "./dist/index.js"
  },
  "private": false,
  "author": "Sameh A. Elalfi <sameh.elalfi.mail@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toctive-com/create-axiom-app.git"
  },
  "bugs": {
    "url": "https://github.com/toctive-com/create-axiom-app/issues"
  },
  "homepage": "https://github.com/toctive-com/create-axiom-app#readme",
  "devDependencies": {
    "@types/bun": "latest",
    "@types/yargs": "^17.0.35"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "node --import tsx --test",
    "build": "bunx tsc --noEmit && tsup --config ./tsup.config.ts",
    "lint": "tsup ./src",
    "start": "bun ./dist/index.js",
    "dev": "bun run --watch ./src/index.ts",
    "release": "bun run build && standard-version && git push --follow-tags origin dev"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.1.0",
    "standard-version": "^9.5.0",
    "tsup": "^8.5.1",
    "yargs": "^18.0.0"
  }
}
